{
  "name": "mc_sync",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/index.mjs",
    "dev": "node --watch src/index.mjs",
    "test": "node --test test/*.test.mjs",
    "verify:day15": "npm test",
    "verify:day19": "npm test && node --test --test-timeout=60000 test/postgres.integration.mjs && node --test --test-timeout=60000 ../mc_web/scripts/verify-day19.mjs",
    "verify:day22": "npm test && node --test --test-timeout=60000 test/auth.integration.mjs",
    "verify:day23": "npm test && node --test --test-timeout=60000 test/setup.integration.mjs",
    "verify:day24": "npm test && node --test --test-timeout=60000 test/invites.integration.mjs"
  },
  "dependencies": {
    "@hocuspocus/server": "4.7.1",
    "drizzle-orm": "0.45.4",
    "jose": "6.2.13",
    "pg": "8.23.1",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@hocuspocus/provider": "4.7.1",
    "embedded-postgres": "18.4.0-beta.17",
    "ws": "^8.18.3",
    "y-protocols": "^1.0.6"
  }
}
