# Copy to .env.local; load explicitly with node --env-file (see README).
# Replace these example credentials with your existing PostgreSQL database.
MC_SYNC_DATABASE_URL=postgresql://mc:REPLACE_ME@127.0.0.1:5432/mc
MC_SYNC_HOST=127.0.0.1
MC_SYNC_PORT=1234
MC_SYNC_STORE_DEBOUNCE_MS=500
MC_SYNC_STORE_MAX_DEBOUNCE_MS=5000
