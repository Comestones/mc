# Copy to .env.local; load explicitly with node --env-file (see README).
# Replace these example credentials with your existing PostgreSQL database.
MC_SYNC_DATABASE_URL=postgresql://mc:REPLACE_ME@127.0.0.1:5432/mc
MC_SYNC_HOST=127.0.0.1
MC_SYNC_PORT=1234
MC_SYNC_STORE_DEBOUNCE_MS=500
MC_SYNC_STORE_MAX_DEBOUNCE_MS=5000

# DAY22: local is unauthenticated and accepts loopback bindings only.
MC_AUTH_MODE=local
# For the authenticated backend set MC_AUTH_MODE=required and supply a random
# secret of at least 32 bytes via your private environment. Do not commit it.
# MC_AUTH_SECRET=
# DAY23 setup requires a separate random bootstrap secret (at least 32 bytes).
# Supply it privately to the first administrator; remove it after setup.
# MC_SETUP_TOKEN=
# No default user is created.
