# Optional local collaboration transport. Leave empty for local-only editing.
VITE_COLLABORATION_URL=ws://127.0.0.1:1234

# Optional account/setup portal. Set only for an MC_AUTH_MODE=required backend.
# This selects setup/login/workspace confirmation instead of the anonymous editor.
# Restart Vite or rebuild after changing. Never put secrets in VITE_* variables.
# VITE_API_URL=http://127.0.0.1:1234
